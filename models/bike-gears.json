 "steps": [
  {
   "part": "cable",
   "say": "The shifter pulls the inner wire through its housing. The wire ends at a barrel adjuster on the body and is clamped under the anchor bolt, so every click moves the wire a set distance."
  },
  {
   "part": "hanger",
   "say": "The hanger is the replaceable tab on the frame that the whole derailleur hangs from. It holds the derailleur body at a fixed spot behind the axle."
  },
  {
   "part": "body",
   "say": "The body is bolted to the hanger. It carries the adjustment screws and the cable anchor bolt. The H and L limit screws stop the linkage so the chain cannot be pushed off either end of the cassette."
  },
  {
   "part": "links",
   "say": "Two parallel links form the parallelogram. Pulling the cable swings them sideways, which carries the cage under the cassette from one sprocket to the next."
  },
  {
   "part": "pknuckle",
   "say": "The p-knuckle joins the links to the cage. It is the pivot the cage turns on and it houses the cage spring."
  },
  {
   "part": "spring",
   "say": "The spring turns the cage backwards so the chain stays tight. When the cable is released it also moves the links back the other way."
  },
  {
   "part": "cage_in",
   "say": "The inner plate of the cage holds the two pulleys in line. It turns on the p-knuckle pivot and swings back as the chain moves to a smaller sprocket."
  },
  {
   "part": "cage_out",
   "say": "The outer plate closes the cage and carries the pulley bolts. Together the two plates keep the pulleys parallel to each other."
  },
  {
   "part": "guide",
   "say": "The guide pulley sits just under the cassette. Its teeth steer the chain sideways onto the sprocket the cage is lined up with."
  },
  {
   "part": "tension",
   "say": "The tension pulley is the lower one. The spring pushes it backward so the loose lower part of the chain is pulled tight, and the chain follows an S shape through both pulleys."
  },
  {
   "part": "chain",
   "say": "The chain is a loop of pinned links. It runs over the top of the sprocket, down to the guide pulley, back through the S bend to the tension pulley, and forward to the front chainring."
  },
  {
   "part": "cog11",
   "say": "The smallest sprocket gives the highest gear. The chain moves onto it when the cage is swung farthest out."
  },
  {
   "part": "cog14",
   "say": "Each sprocket has its own tooth count, so each one gives a different ratio between pedalling and wheel speed."
  },
  {
   "part": "cog18",
   "say": "The chain is shown on this middle sprocket. Its teeth fit between the chain's rollers and drive the wheel."
  },
  {
   "part": "cog23",
   "say": "Larger sprockets are closer to the frame. The chain only needs to be moved a few millimetres from one sprocket to the next."
  },
  {
   "part": "cog30",
   "say": "The largest sprocket gives the lowest gear for climbing. It sits closest to the frame, with spacers keeping the sprockets apart."
  },
  {
   "part": "lockring",
   "say": "The lockring screws into the end of the freehub body and clamps the whole stack of sprockets in place."
  },
  {
   "part": "hub",
   "say": "The sprockets slide onto the splines of the freehub body. A one-way clutch inside it lets the rider coast while the sprockets stop driving the wheel."
  }
 ]
}