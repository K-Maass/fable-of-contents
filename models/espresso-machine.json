 "steps": [
  {
   "part": "tank",
   "say": "Holds the water for several shots. A short outlet at the bottom feeds a tube to the pump, and the tank lifts out to be refilled."
  },
  {
   "part": "hoses",
   "say": "Flexible tubes carry water from the tank outlet to the pump, then from the pump up to the boiler. They push onto the barbs at each end."
  },
  {
   "part": "pump",
   "say": "A vibration pump: an electromagnet coil drives a piston back and forth, pushing water out under pressure toward the boiler. Brew Coffee Home puts the target near 9 bar for espresso."
  },
  {
   "part": "boiler",
   "say": "A metal cylinder that holds the water while it heats. A temperature probe and controller switch the heater on and off to keep the water steady."
  },
  {
   "part": "element",
   "say": "A resistive heating element runs into the boiler from the rear. Current through the coil heats the water around it."
  },
  {
   "part": "solenoid",
   "say": "A three-way solenoid valve opens the boiler to the group head when a shot starts. When the shot ends it switches the group head to the drain, so pressure drops before the portafilter comes off."
  },
  {
   "part": "group",
   "say": "The group head receives hot water from the boiler and delivers it down into the portafilter. A rubber gasket seals the portafilter against it."
  },
  {
   "part": "screen",
   "say": "A perforated steel disc under the group head. It breaks the incoming water into many small streams so the whole coffee bed is wetted evenly."
  },
  {
   "part": "portafilter",
   "say": "The handle and holder that twists into the group head on two lugs. Coffee extracts inside it, and two spouts guide the espresso down."
  },
  {
   "part": "basket",
   "say": "A steel basket that holds the ground coffee. Its floor is perforated so the water can pass through the coffee bed and out, while the grounds stay in."
  },
  {
   "part": "cup",
   "say": "Collects the espresso as it falls from the spouts. It stands on the drip tray grille directly under the portafilter."
  },
  {
   "part": "tray",
   "say": "Catches water released from the group head, drips and spills. Spills fall through the slots in the grille into the tray below, which slides out to be emptied."
  },
  {
   "part": "valve",
   "say": "A manual valve on the boiler. Turning the knob opens or shuts the steam path to the wand."
  },
  {
   "part": "wand",
   "say": "A tube that carries steam out of the machine to heat and froth milk. It is bent so the tip can be dipped into a jug."
  },
  {
   "part": "opv",
   "say": "A spring-loaded valve on the boiler. If pressure rises too far it opens and lets steam or water out."
  },
  {
   "part": "gauge",
   "say": "A dial on the front connected to the boiler by a thin tube. It shows the pressure inside."
  },
  {
   "part": "chassis",
   "say": "The steel base, shelf and posts that carry the boiler, pump and tank, and keep the parts at fixed heights."
  },
  {
   "part": "casing",
   "say": "The steel hood: two side panels, back, top and front. It covers the machine, and the top plate warms cups. It lifts off first."
  }
 ]
}