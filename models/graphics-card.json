 "steps": [
  {
   "part": "fans",
   "say": "Three fans pull room air in and push it down through the metal fins underneath."
  },
  {
   "part": "shroud",
   "say": "The plastic shroud holds the fans and steers the air, so it has to pass through the fins on its way out."
  },
  {
   "part": "fins",
   "say": "Dozens of thin aluminium fins give the heat a large surface to leave from. Air moving between them carries it away."
  },
  {
   "part": "pipes",
   "say": "Copper heat pipes move heat sideways along the card. A liquid inside boils at the hot end, travels as vapour and turns back to liquid at the cool end."
  },
  {
   "part": "plate",
   "say": "The copper cold plate presses against the graphics chip and takes up its heat."
  },
  {
   "part": "gpu",
   "say": "The graphics chip does the calculating. Nearly all the electricity it uses ends up as heat, which is why the cooler is the largest part of the card."
  },
  {
   "part": "vram",
   "say": "Memory chips sit close around it. They hold what the chip is working on, such as game textures or an AI model."
  },
  {
   "part": "vrm",
   "say": "The power stages turn the 12 volts from the power supply into roughly 1 volt at a very high current for the chip."
  },
  {
   "part": "power",
   "say": "This connector brings most of the card's power straight from the power supply."
  },
  {
   "part": "pcb",
   "say": "The circuit board connects everything. Its gold contacts plug into the motherboard, which carries the data and a small share of the power."
  },
  {
   "part": "ports",
   "say": "The display ports send the finished picture to your screens."
  },
  {
   "part": "bracket",
   "say": "The steel bracket screws the card to the computer case."
  },
  {
   "part": "back",
   "say": "The backplate stiffens the board so the heavy cooler doesn't bend it."
  }
 ]
}